# Vercel project > Settings > Environment Variables (server-side only)
# Set these two in Vercel, then redeploy. Do not use NEXT_PUBLIC_/VITE_ prefixes.
BGE_SERVER_URL=https://your-bge-server.example.com
BGE_API_KEY=replace-with-a-long-random-shared-secret

# BGE Python server process environment (not automatically read from this file)
# Use the same BGE_API_KEY on the Python server and Vercel.
BGE_REQUIRE_AUTH=true
BGE_MODEL_PATH=/absolute/path/to/models/bge-m3
BGE_DOCS_PATH=/absolute/path/to/data/docs.json
BGE_DEVICE=cpu
# Browser-local direct access only; Vercel uses a server-to-server proxy.
BGE_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
